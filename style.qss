/* ========================================================================= */
/* Dash — launcher                                                           */
/* ========================================================================= */

/* This file is a template. Every color is a double-braced token filled in by
   src/theme.py from the light or dark palette; load it through
   theme.apply_theme() or theme.render_stylesheet(), never as it is. */

/* --------------------------------------------------------- search & results */

#SearchInput {
    background: transparent;
    border: none;
    color: {{search_text}};
    placeholder-text-color: {{search_placeholder}};
    selection-background-color: {{accent_strong}};
    selection-color: {{accent_strong_text}};
}

#SearchContainer {
    background-color: {{search_bg}};
    border: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#SearchContainer:focus-within {
    background-color: {{search_focus_bg}};
}

#SearchTree {
    background-color: {{tree_bg}};
    border: none;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 0px;
}

#SearchContainer[treeVisible="true"] {
    border-top-right-radius: 0px;
}

#ResultsList[treeVisible="true"] {
    border-bottom-right-radius: 0px;
}

#SearchMeta {
    background: transparent;
    border: none;
}

#SearchMetaDay {
    font-weight: 600;
    color: {{clock_day_text}};
}

#SearchMetaDate {
    color: {{clock_date_text}};
}

/* Edit mode: highlight the search box so the mode is obvious. */
#SearchContainer[editMode="true"] {
    background-color: {{search_edit_bg}};
}

#ResultsList {
    background-color: {{results_bg}};
    border: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    border-bottom-left-radius: 0px;
    /* Inset so the selected row reads as a card; vertical value must match
       RESULTS_LIST_PADDING_V in launcher_gui.py. */
    padding: 4px 6px;
}

#ResultIconTile {
    background-color: {{tile_bg}};
    border-radius: 10px;
}

ResultRow[selected="true"] #ResultIconTile {
    background-color: {{tile_selected_bg}};
}

#ResultsList::item:selected {
    background-color: {{row_selected_bg}};
    border: none;
    border-radius: 7px;
}

#ResultsList::item:hover {
    background-color: {{row_hover_bg}};
}

#ResultsList[editMode="true"] {
    background-color: {{results_edit_bg}};
}

/* Text colors the ui.*_text_color settings replace when they are set. */
#ResultCommandLabel {
    font-weight: bold;
    color: {{result_text}};
}

#ResultDescriptionLabel {
    color: {{description_text}};
}

/* Usage count: a quiet pill that reads as metadata, not as a third text line. */
#ResultRunCounterLabel {
    color: {{pill_text}};
    background-color: {{tile_bg}};
    border: 1px solid {{border}};
    border-radius: 9px;
    padding: 1px 8px;
    margin-right: 4px;
}

ResultRow[selected="true"] #ResultRunCounterLabel {
    background-color: {{tile_selected_bg}};
    border-color: {{pill_selected_border}};
    color: {{pill_selected_text}};
}

#NewCommandButton,
#ResultEditButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0px;
}

#NewCommandButton:hover,
#ResultEditButton:hover {
    background: {{button_hover_bg}};
}

#ShortcutHint {
    color: {{launcher_muted}};
    font-size: 12px;
    padding: 0px;
}

#LauncherFooter {
    background-color: {{footer_bg}};
    border: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* ---------------------------------------------------------------- aliases -- */

#AliasEnterBox {
    background: {{alias_input_bg}};
    border: 1px solid transparent;
    border-radius: 6px;
    color: {{text}};
    padding: 8px 10px;
    min-height: 28px;
}

#AliasEnterBox::placeholder {
    color: {{alias_placeholder}};
}

#AliasEnterBox:focus {
    background: {{accent_soft_bg}};
    border: 1px solid {{accent}};
}

#Alias {
    background-color: {{chip_bg}};
    border: 1px solid {{panel_border}};
    border-radius: 6px;
    padding: 2px 0px;
}

#AliasDelete {
    color: {{text_muted}};
    font-size: 12px;
}

#Alias:hover #AliasDelete {
    color: {{text}};
}

#Alias:hover {
    background-color: {{chip_hover_bg}};
}

#AliasGridContainer {
    background: {{alias_grid_bg}};
    border: 1px solid {{alias_grid_border}};
    border-radius: 8px;
    padding: 6px;
}

#AliasGridContainer:focus-within {
    border: 1px solid {{accent}};
}

/* --------------------------------------------------------- command editor -- */

QMainWindow#mainWindow {
    /* Transparent so only the rounded panel shows; no square corners behind it */
    background: transparent;
}

#CommandEditorPanel {
    background-color: {{panel_bg}};
    border: 1px solid {{panel_border}};
    border-radius: 8px;
}

#SettingsEditorPanel {
    background-color: {{panel_bg}};
    border: 1px solid {{panel_border}};
    border-radius: 8px;
}

QDialog#IconStyleDialog,
QDialog#LibraryPickerDialog {
    background-color: {{panel_bg}};
    border: 1px solid {{panel_border}};
    border-radius: 8px;
}

#ProgramImportDialog {
    background-color: {{panel_bg}};
    border: 1px solid {{panel_border}};
    border-radius: 8px;
}

#ProgramImportList {
    background: {{input_bg}};
    border: 1px solid {{border}};
    border-radius: 8px;
    color: {{text}};
}

#ProgramImportList::item {
    padding: 8px;
    border-bottom: 1px solid {{list_divider}};
}

#ProgramImportList::item:last {
    border-bottom: none;
}

#ProgramImportList::item:hover {
    background: {{list_hover_bg}};
}

#ScanResultList {
    background: {{input_bg}};
    border: 1px solid {{border}};
    border-radius: 8px;
    outline: none;
}

#ScanResultList::item {
    border-bottom: 1px solid {{list_divider}};
    padding: 0px;
}

#ScanResultList::item:hover {
    background: {{list_hover_bg}};
}

#ImportRow {
    background: transparent;
}

#importRowName {
    font-size: 13px;
    color: {{text}};
}

#importRowLocation,
#importRowMeta {
    font-size: 11px;
    color: {{text_muted}};
}

#importRowError {
    font-size: 11px;
    color: {{error_text}};
}

/* Tabs in the scan dialog: one page per kind of thing */
#ProgramImportTabs::pane {
    border: none;
    background: transparent;
}

#ProgramImportTabs QTabBar::tab {
    background: transparent;
    color: {{text_muted}};
    padding: 8px 14px;
    margin-right: 6px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
}

#ProgramImportTabs QTabBar::tab:selected {
    color: {{text}};
    border-bottom: 2px solid {{accent}};
}

#ProgramImportTabs QTabBar::tab:hover:!selected {
    color: {{text_hover}};
}

QPushButton#programImportSelectButton {
    background: transparent;
    border: none;
    color: {{accent}};
    padding: 4px 8px;
    font-size: 12px;
}

QPushButton#programImportSelectButton:hover {
    color: {{accent_hover}};
    text-decoration: underline;
}

#CommandEditTitle {
    font-size: 20px;
    font-weight: bold;
    color: {{text}};
}

#CommandEditTitle[editorMode="new"] {
    color: {{accent_hover}};
}

#SettingsTitle {
    font-size: 20px;
    font-weight: bold;
    color: {{text}};
}

#CommandEditIcon {
    background: {{raised_bg}};
    border: 1px solid {{icon_tile_border}};
    border-radius: 8px;
}

#CommandEditIcon:hover {
    background: {{raised_hover_bg}};
    border: 1px solid {{accent}};
}

#fieldLabel {
    font-weight: 600;
    letter-spacing: 0px;
    font-size: 12px;
    color: {{text_muted}};
}

#footerHint {
    font-size: 12px;
    color: {{text_hint}};
}

#validationMessage {
    color: {{danger}};
    font-size: 12px;
}

#CommandNameEditBox {
    font-size: 27px;
    font-weight: bold;
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0px;
    padding: 2px 0px;
}

#CommandNameEditBox:hover {
    border-bottom: 1px solid palette(mid);
}

#CommandNameEditBox:focus {
    border-bottom: 1px solid {{accent_strong}};
}

#DeleteCommandObject {
    color: {{destructive}};
    font-weight: bold;
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0px;
    padding: 2px 0px;
}

#DeleteCommandObject:hover {
    border-bottom: 1px solid palette(mid);
}

/* ========================================================================= */
/* Icon editor                                                               */
/* ========================================================================= */

/* ------------------------------------------------------------------ base -- */

QMainWindow,
QDialog,
QWidget#central {
    background: {{window_bg}};
}

QLabel {
    color: {{text}};
}

QToolTip {
    background: {{tooltip_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 5px;
}

QStatusBar {
    background: {{window_bg}};
    color: {{text_muted}};
    border-top: 1px solid {{border}};
}

QStatusBar::item {
    border: none;
}

/* ------------------------------------------------------------ typography -- */

QLabel#appTitle {
    font-size: 22px;
    font-weight: 700;
    color: {{text}};
}

/* Home panel, styled to match the Dash command editor it opens from */
#homePanel {
    background: {{panel_bg}};
    border: 1px solid {{panel_border}};
    border-radius: 8px;
}

#optionCard {
    background: {{raised_bg}};
    border: 1px solid {{border}};
    border-radius: 10px;
}

#optionCard:hover {
    background: {{raised_hover_bg}};
    border: 1px solid {{accent_strong}};
}

#optionCard:focus {
    background: {{raised_hover_bg}};
    border: 1px solid {{accent}};
}

#optionTitle {
    font-size: 15px;
    font-weight: 600;
    color: {{text}};
}

#optionDesc {
    font-size: 12px;
    color: {{text_muted}};
}

QLabel#dialogTitle {
    font-size: 17px;
    font-weight: 700;
    color: {{text}};
}

QLabel#sectionLabel {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: {{text_muted}};
}

QFrame#dividerLine {
    border: none;
    border-top: 1px solid {{border}};
    max-height: 1px;
    height: 1px;
    background: transparent;
}

QLabel#sourceName {
    font-size: 14px;
    color: {{text}};
}

QLabel#hintText,
QLabel#dialogSubtitle {
    font-size: 12px;
    color: {{text_muted}};
}

/* --------------------------------------------------------------- previews -- */

QLabel#iconPreview {
    border: 1px solid {{border}};
    border-radius: 16px;
}

QLabel#dialogPreview {
    border: 1px solid {{border}};
    border-radius: 12px;
}

/* ---------------------------------------------------------------- inputs -- */

QLineEdit {
    background: {{input_bg}};
    color: {{text}};
    border: 1px solid {{input_border}};
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    selection-background-color: {{accent}};
    selection-color: {{accent_text}};
}

QLineEdit:focus {
    border: 1px solid {{accent}};
}

QCheckBox {
    color: {{text_muted}};
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid {{input_border}};
    border-radius: 4px;
    background: {{input_bg}};
}

QCheckBox::indicator:checked {
    background: {{accent}};
    border: 1px solid {{accent}};
}

/* ----------------------------------------------------------- combo boxes -- */

QComboBox {
    background: {{input_bg}};
    color: {{text}};
    border: 1px solid {{input_border}};
    border-radius: 8px;
    padding: 8px 34px 8px 10px;
    font-size: 13px;
}

QComboBox:focus {
    border-color: {{accent}};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    background: {{accent_strong}};
    border: none;
    border-left: 1px solid {{accent_strong_border}};
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

QComboBox::drop-down:hover {
    background: {{accent_strong_hover}};
}

QComboBox::down-arrow {
    image: url(assets/icons/spinbox-arrow-down.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background: {{input_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: {{row_selected_bg}};
    selection-color: {{text_strong}};
}

/* ------------------------------------------------------------- spinboxes -- */

QSpinBox,
QDoubleSpinBox {
    background: {{input_bg}};
    color: {{text}};
    border: 1px solid {{input_border}};
    border-radius: 8px;
    padding: 8px 34px 8px 10px;
    font-size: 13px;
    selection-background-color: {{accent}};
    selection-color: {{accent_text}};
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    width: 24px;
    right: 0px;
    background: {{accent_strong}};
    border: none;
    border-left: 1px solid {{accent_strong_border}};
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 7px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 7px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background: {{accent_strong_hover}};
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(assets/icons/spinbox-arrow-up.svg);
    width: 10px;
    height: 6px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(assets/icons/spinbox-arrow-down.svg);
    width: 10px;
    height: 6px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid {{accent}};
}

/* -------------------------------------------------------------- groupbox -- */

QGroupBox {
    color: {{text}};
    font-weight: 600;
    border: 1px solid {{border}};
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 6px;
    background: {{raised_bg}};
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: {{accent}};
}

/* -------------------------------------------------------------- scroll area -- */

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea>QWidget>QWidget {
    background: transparent;
}

/* --------------------------------------------------------------- buttons -- */

QPushButton {
    background: {{button_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 7px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background: {{button_hover_bg}};
}

QPushButton:default {
    background: {{accent}};
    color: {{accent_text}};
    border: 1px solid {{accent}};
}

QPushButton:default:hover {
    background: {{accent_hover}};
}

/* ----------------------------------------------- command type selector -- */

QFrame#typeSelector {
    background: {{input_bg}};
    border: 1px solid {{border}};
    border-radius: 9px;
}

QPushButton#typeSegment {
    background: transparent;
    color: {{text_subtle}};
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 13px;
}

QPushButton#typeSegment:hover {
    background: {{button_bg}};
    color: {{text}};
}

QPushButton#typeSegment:checked {
    background: {{button_hover_bg}};
    color: {{text}};
    font-weight: 600;
}

/* ------------------------------------------------------------ icon grid -- */

QListWidget {
    background: {{input_bg}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QListWidget::item {
    border-radius: 8px;
}

QListWidget::item:hover {
    background: {{button_bg}};
}

QListWidget::item:selected {
    background: {{list_selected_bg}};
    color: {{text}};
    border: none;
}

/* The settings page is long enough that the scrollbar has to be findable,
   not merely present: a visible track shows the bar exists at all, and the
   handle doubles as a read-out of how much page is left. Scoped so the
   launcher's results list keeps its near-invisible bar. */
#SettingsScrollArea QScrollBar:vertical {
    background: {{scroll_track}};
    width: 12px;
    margin: 2px 2px 2px 0px;
    border-radius: 6px;
}

#SettingsScrollArea QScrollBar::handle:vertical {
    background: {{scroll_handle}};
    border-radius: 4px;
    min-height: 40px;
    margin: 2px;
}

#SettingsScrollArea QScrollBar::handle:vertical:hover {
    background: {{scroll_handle_hover}};
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: {{scrollbar_handle}};
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: {{scrollbar_handle_hover}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}